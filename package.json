{
  "name": "luogu-markdown-editor",
  "displayName": "Luogu Markdown Editor",
  "description": "洛谷 Markdown & KaTeX 实时预览编辑器 - VSCode 扩展版。左侧编辑，右侧预览，侧边栏工具箱。",
  "version": "1.2.13",
  "publisher": "wudream",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Formatters"
  ],
  "keywords": [
    "markdown",
    "luogu",
    "katex",
    "latex",
    "math",
    "preview",
    "editor",
    "洛谷"
  ],
  "icon": "media/icon.png",
  "activationEvents": [
    "onLanguage:markdown",
    "onView:luogu-editor.toolbox",
    "onView:luogu-editor.templates"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "luogu-editor",
          "title": "Luogu Markdown",
          "icon": "media/sidebar-icon.svg"
        }
      ]
    },
    "views": {
      "luogu-editor": [
        {
          "id": "luogu-editor.toolbox",
          "name": "格式工具箱",
          "visibility": "visible"
        },
        {
          "id": "luogu-editor.templates",
          "name": "模板与工具",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "luogu-editor.openPreview",
        "title": "Luogu Markdown: 打开实时预览",
        "icon": "$(open-preview)"
      },
      {
        "command": "luogu-editor.closePreview",
        "title": "Luogu Markdown: 关闭预览"
      },
      {
        "command": "luogu-editor.copyMarkdown",
        "title": "Luogu Markdown: 复制 Markdown 源码"
      },
      {
        "command": "luogu-editor.autoFixSpacing",
        "title": "Luogu Markdown: 一键排版规范修复"
      },
      {
        "command": "luogu-editor.insertBold",
        "title": "Luogu Markdown: 加粗"
      },
      {
        "command": "luogu-editor.insertItalic",
        "title": "Luogu Markdown: 斜体"
      },
      {
        "command": "luogu-editor.insertStrikethrough",
        "title": "Luogu Markdown: 删除线"
      },
      {
        "command": "luogu-editor.insertHeading1",
        "title": "Luogu Markdown: H1 标题"
      },
      {
        "command": "luogu-editor.insertHeading2",
        "title": "Luogu Markdown: H2 标题"
      },
      {
        "command": "luogu-editor.insertHeading3",
        "title": "Luogu Markdown: H3 标题"
      },
      {
        "command": "luogu-editor.insertHeading4",
        "title": "Luogu Markdown: H4 标题"
      },
      {
        "command": "luogu-editor.insertInlineCode",
        "title": "Luogu Markdown: 行内代码"
      },
      {
        "command": "luogu-editor.insertCodeBlock",
        "title": "Luogu Markdown: 代码块"
      },
      {
        "command": "luogu-editor.insertQuote",
        "title": "Luogu Markdown: 引用"
      },
      {
        "command": "luogu-editor.insertMathInline",
        "title": "Luogu Markdown: 行内公式"
      },
      {
        "command": "luogu-editor.insertMathBlock",
        "title": "Luogu Markdown: 行间公式"
      },
      {
        "command": "luogu-editor.insertCalloutInfo",
        "title": "Luogu Markdown: info 折叠框"
      },
      {
        "command": "luogu-editor.insertCalloutSuccess",
        "title": "Luogu Markdown: success 折叠框"
      },
      {
        "command": "luogu-editor.insertCalloutWarning",
        "title": "Luogu Markdown: warning 折叠框"
      },
      {
        "command": "luogu-editor.insertCalloutError",
        "title": "Luogu Markdown: error 折叠框"
      },
      {
        "command": "luogu-editor.insertTable",
        "title": "Luogu Markdown: 插入表格"
      },
      {
        "command": "luogu-editor.insertEpigraph",
        "title": "Luogu Markdown: 引言"
      },
      {
        "command": "luogu-editor.insertAlignCenter",
        "title": "Luogu Markdown: 居中"
      },
      {
        "command": "luogu-editor.insertAlignRight",
        "title": "Luogu Markdown: 居右"
      },
      {
        "command": "luogu-editor.insertBilibili",
        "title": "Luogu Markdown: Bilibili 视频"
      },
      {
        "command": "luogu-editor.insertLink",
        "title": "Luogu Markdown: 链接"
      },
      {
        "command": "luogu-editor.insertImage",
        "title": "Luogu Markdown: 图片"
      },
      {
        "command": "luogu-editor.insertTaskList",
        "title": "Luogu Markdown: 任务列表"
      },
      {
        "command": "luogu-editor.insertHR",
        "title": "Luogu Markdown: 分割线"
      },
      {
        "command": "luogu-editor.insertTemplateDemo",
        "title": "Luogu Markdown: 全特性演示模板"
      },
      {
        "command": "luogu-editor.insertTemplateSolution",
        "title": "Luogu Markdown: 题解模板"
      },
      {
        "command": "luogu-editor.insertTemplateProblem",
        "title": "Luogu Markdown: 题面模板"
      },
      {
        "command": "luogu-editor.insertTemplateArticle",
        "title": "Luogu Markdown: 学术文章模板"
      },
      {
        "command": "luogu-editor.toggleTheme",
        "title": "Luogu Markdown: 切换亮/暗主题"
      },
      {
        "command": "luogu-editor.exportHtml",
        "title": "Luogu Markdown: 导出 HTML",
        "icon": "$(export)"
      },
      {
        "command": "luogu-editor.exportPdf",
        "title": "Luogu Markdown: 导出 PDF（先导出 HTML，再用浏览器打印导出）",
        "icon": "$(file-pdf)"
      },
      {
        "command": "luogu-editor.insertUList",
        "title": "Luogu Markdown: 插入无序列表"
      },
      {
        "command": "luogu-editor.insertOList",
        "title": "Luogu Markdown: 插入有序列表"
      },
      {
        "command": "luogu-editor.headingPromote",
        "title": "Luogu Markdown: 提升标题等级"
      },
      {
        "command": "luogu-editor.headingDemote",
        "title": "Luogu Markdown: 降低标题等级"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "luogu-editor.openPreview",
          "when": "editorLangId == markdown",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "luogu-editor.openPreview",
          "when": "editorLangId == markdown",
          "group": "luogu@1"
        },
        {
          "command": "luogu-editor.copyMarkdown",
          "when": "editorLangId == markdown",
          "group": "luogu@2"
        },
        {
          "command": "luogu-editor.autoFixSpacing",
          "when": "editorLangId == markdown",
          "group": "luogu@3"
        }
      ]
    },
    "configuration": {
      "title": "Luogu Markdown",
      "properties": {
        "luogu-editor.autoSync": {
          "type": "boolean",
          "default": true,
          "description": "编辑时自动同步预览"
        }
      }
    },
    "keybindings": [
      {
        "command": "luogu-editor.headingPromote",
        "key": "ctrl+shift+up",
        "when": "editorTextFocus && !editorReadonly && editorLangId == markdown",
        "mac": "cmd+shift+up"
      },
      {
        "command": "luogu-editor.headingDemote",
        "key": "ctrl+shift+down",
        "when": "editorTextFocus && !editorReadonly && editorLangId == markdown",
        "mac": "cmd+shift+down"
      },
      {
        "command": "luogu-editor.insertHR",
        "key": "ctrl+shift+h",
        "when": "editorTextFocus && !editorReadonly && editorLangId == markdown",
        "mac": "cmd+shift+h"
      },
      {
        "command": "luogu-editor.insertBold",
        "key": "ctrl+b",
        "when": "editorTextFocus && !editorReadonly && editorLangId == markdown",
        "mac": "cmd+b"
      },
      {
        "command": "luogu-editor.insertItalic",
        "key": "ctrl+i",
        "when": "editorTextFocus && !editorReadonly && editorLangId == markdown",
        "mac": "cmd+i"
      },
      {
        "command": "luogu-editor.insertStrikethrough",
        "key": "ctrl+d",
        "when": "editorTextFocus && !editorReadonly && editorLangId == markdown",
        "mac": "cmd+d"
      },
      {
        "command": "luogu-editor.insertMathInline",
        "key": "ctrl+m",
        "when": "editorTextFocus && !editorReadonly && editorLangId == markdown",
        "mac": "cmd+m"
      },
      {
        "command": "luogu-editor.insertLink",
        "key": "ctrl+shift+l",
        "when": "editorTextFocus && !editorReadonly && editorLangId == markdown",
        "mac": "cmd+shift+l"
      },
      {
        "command": "luogu-editor.insertImage",
        "key": "ctrl+shift+i",
        "when": "editorTextFocus && !editorReadonly && editorLangId == markdown",
        "mac": "cmd+shift+i"
      },
      {
        "command": "luogu-editor.insertQuote",
        "key": "ctrl+shift+q",
        "when": "editorTextFocus && !editorReadonly && editorLangId == markdown",
        "mac": "cmd+shift+q"
      },
      {
        "command": "luogu-editor.insertInlineCode",
        "key": "ctrl+shift+1",
        "when": "editorTextFocus && !editorReadonly && editorLangId == markdown",
        "mac": "cmd+shift+1"
      },
      {
        "command": "luogu-editor.insertTable",
        "key": "ctrl+shift+2",
        "when": "editorTextFocus && !editorReadonly && editorLangId == markdown",
        "mac": "cmd+shift+2"
      },
      {
        "command": "luogu-editor.insertUList",
        "key": "ctrl+shift+7",
        "when": "editorTextFocus && !editorReadonly && editorLangId == markdown",
        "mac": "cmd+shift+7"
      },
      {
        "command": "luogu-editor.insertOList",
        "key": "ctrl+shift+8",
        "when": "editorTextFocus && !editorReadonly && editorLangId == markdown",
        "mac": "cmd+shift+8"
      },
      {
        "command": "luogu-editor.insertTaskList",
        "key": "ctrl+shift+9",
        "when": "editorTextFocus && !editorReadonly && editorLangId == markdown",
        "mac": "cmd+shift+9"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "echo 'Ready to publish'"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wudream813/LuoguMarkdownEditor-in-vscode"
  },
  "license": "MIT",
  "devDependencies": {
    "@vscode/vsce": "^3.9.2"
  }
}
